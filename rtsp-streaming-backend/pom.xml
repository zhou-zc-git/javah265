<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version> <!-- 更新 Spring Boot 版本为 2.7.18 -->
        <relativePath/> <!-- 从仓库查找父POM -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>rtsp-streaming-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rtsp-streaming-backend</name>
    <description>RTSP to HLS Streaming Backend (JDK 1.8)</description> <!-- 项目描述, 指明JDK版本 -->
    <properties>
        <java.version>1.8</java.version> <!-- 更新 Java 版本为 1.8 -->
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <!-- 版本由 Spring Boot 父POM 2.7.18 管理 -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Spring Boot 2.x parent usually sets the compiler source/target correctly.
                 However, if issues arise or specific control is needed, uncomment and configure:
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            -->
        </plugins>
    </build>
</project>
